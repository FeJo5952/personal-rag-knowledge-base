# Path to your Obsidian vault (required)
VAULT_PATH=C:\path\to\your\vault

# Ollama models: use any model you've pulled with `ollama pull <name>` that fits your GPU/RAM
EMBED_MODEL=embeddinggemma    # turns notes and questions into vectors (delete chroma_db and re-index after changing)
LLM_MODEL=llama3.1:8b         # writes the answers
JUDGE_MODEL=qwen2.5:7b        # grades answers during evaluation; best if different from LLM_MODEL

# Optional tuning (defaults shown)
CHROMA_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# Retrieval
RETRIEVAL_MODE=hybrid                          # dense | bm25 | hybrid | hybrid_rerank
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2     # only used by hybrid_rerank; any fastembed cross-encoder
