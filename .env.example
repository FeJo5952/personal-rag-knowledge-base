# Path to your Obsidian vault (required)
VAULT_PATH=C:\path\to\your\vault

# Ollama models: use any model you've pulled with `ollama pull <name>` that fits your GPU/RAM
EMBED_MODEL=embeddinggemma    # turns notes and questions into vectors (delete chroma_db and re-index after changing)
LLM_MODEL=llama3.1:8b         # writes the answers
JUDGE_MODEL=qwen2.5:7b        # grades answers during evaluation; best if different from LLM_MODEL

# Optional tuning (defaults shown)
CHROMA_DIR=chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# Retrieval
RETRIEVAL_MODE=hybrid                          # dense | bm25 | hybrid | hybrid_rerank
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2     # only used by hybrid_rerank; any fastembed cross-encoder

# PostgreSQL catalog of the vault (optional; leave both URLs empty to use notes search only)
# Create the roles and database with sql/roles.sql first. URL-encode special characters in passwords.
DATABASE_URL=postgresql://rag_reader:READER_PASSWORD@localhost:5432/rag_kb          # read-only, runs the LLM's SQL
DATABASE_LOADER_URL=postgresql://rag_owner:OWNER_PASSWORD@localhost:5432/rag_kb     # fills the tables when indexing
SQL_MODEL=llama3.1:8b       # writes the SQL (defaults to LLM_MODEL)
SQL_TIMEOUT_MS=5000         # queries running longer are cancelled
SQL_MAX_ROWS=50             # rows kept from a query result
